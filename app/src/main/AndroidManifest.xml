<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive OS only (Pleos Connect). -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />
    <!-- AAOS head units have no portrait mode / touch-free variants; do not require them. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <!--
        Only what the shipped features read. All are normal-level:
        no runtime permission dialog. Pleos: SOC (CAR_ENERGY), climate,
        seats (heat, backrest, occupancy), windows, doors, cabin light.
    -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- AAOS standard properties: fuel type + battery capacity (CAR_INFO), charge port. Normal. -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY_PORTS" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- Build G: outside temperature for the heating estimate (normal permission). -->
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <!-- Stay service: keeps signals alive while another app is in front. Normal. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Round 2 G1: start the stay service at boot (an allowed background start). Normal, install-time. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".PleosApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:appCategory="productivity"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PleosApp">

        <!--
            Round 2 C-1: the app does not implement CCP (rotary) focus; every control is touch only.
            Pleos CCP guide: "CCP를 지원하지 않는 앱은 <application> 요소에 다음 메타데이터를 추가하여 CCP 미지원 앱임을 선언합니다."
        -->
        <meta-data android:name="com.hmg.rotary.ROTARY_SUPPORTED" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden|navigation"
            android:theme="@style/Theme.PleosApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                No "distractionOptimized" meta-data: every screen is park-only, so
                the system hides the app while driving. DrivingStateGate is a second layer.
            -->
        </activity>
        <service
            android:name=".stay.StayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps parked-car signal listeners alive for the ignition cycle so a stay that begins while another app is in front is still counted, and the exit checklist and safety notices still appear. Shows no stay content while driving." />
        </service>
        <!--
            Round 2 G1. BOOT_COMPLETED is a protected broadcast (only the system can send it), so exporting the
            receiver lets no other app trigger it. Starts the stay service only after onboarding.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
