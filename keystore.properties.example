# Copy to keystore.properties (git-ignored) and fill in. NEVER commit the real file or the .jks.
# Create a keystore once (JDK keytool, bundled with Android Studio):
#   "C:\Program Files\Android\Android Studio\jbr\bin\keytool.exe" -genkeypair -v ^
#     -keystore keystore\release.jks -alias release -keyalg RSA -keysize 2048 -validity 10000
# Back up keystore\release.jks + passwords somewhere safe (password manager). Losing it means
# you can never ship an update under the same signature.
storeFile=keystore/release.jks
storePassword=CHANGE_ME
keyAlias=release
keyPassword=CHANGE_ME
